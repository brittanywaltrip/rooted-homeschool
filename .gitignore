# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
public/hero-video.mp4

# Capacitor
ios/App/Pods
ios/App/build
android/.gradle
android/app/build
android/build
android/local.properties
android/.idea
android/captures

# @capacitor/assets PWA output (root-level, broken paths in generated manifest)
/icons

# Playwright — generated reports + saved auth state with live tokens
playwright-report/
test-results/
e2e/.auth/

# Email template audit dumps — review-only, may contain template HTML; never commit
email-audit/

# ── Local scratch, never committed ───────────────────────────────────────────
# These sit in the working tree on purpose and are not part of the repo. They
# are listed here so `git status` stays readable and so a wide `git add -A`
# cannot sweep them into a commit. Ignoring them does NOT delete them, and it
# does not affect any file already tracked.

# Scratch files and scrap directories, by the leading-underscore convention
# (_to_delete/, _gone2.lock, _sid.py). No tracked file starts with one.
/_*

# One-off helper scripts written to drive a single commit
/commit-*.sh

# FUSE/NFS leftovers from a file deleted while still open. They appear next to
# whatever was open at the time, so this is not anchored to the root.
.fuse_hidden*

# Planning docs and CC prompt drafts. Kept local until the work is real; the
# docs that ARE part of the repo (CURRICULUM-SCHEDULING.md, PAST-DAY-LOGGING.md,
# YEARBOOK-CONTENT-REVAMP.md) are already tracked and unaffected by these.
*-CC-PROMPT.md
/BUZZ-PLAN-*.md
/docs/saved-plans/
/docs/YEARBOOK-00-TODAY-BOOK-STRIP.md
/docs/YEARBOOK-CUSTOMIZATION-ROADMAP.md
